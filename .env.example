# Workshop environment — copy to `.env` and fill with YOUR values.
# These come from the workshop CloudFormation Outputs (they change per account/session).
# The real `.env` is gitignored — never commit it.

# ── AWS session ──────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=<your-account-id>

# Temporary workshop credentials — paste fresh values here each session.
# Scripts/commands load these from .env so you don't have to re-export them per
# terminal. The real .env is gitignored. Renew these before a deploy.
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
AWS_SESSION_TOKEN=<session-token>

# ── Pre-created IAM roles (the workshop account cannot create roles itself) ──
# Gateway execution role — the MCP gateway assumes this.
GATEWAY_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/<gateway-execution-role>
# Lambda execution role — the 4 gateway tool Lambdas run as this.
GATEWAY_TOOL_LAMBDA_ROLE_ARN=arn:aws:iam::<account-id>:role/<gateway-tool-lambda-role>
# Role used when provisioning resources.
SOLUTION_ACCESS_ROLE_ARN=arn:aws:iam::<account-id>:role/<solution-access-role>

# ── S3 buckets ───────────────────────────────────────────────────────────────
CODE_BUCKET_FOR_AUTOMATION_NAME=<code-bucket-name>
DATA_BUCKET_FOR_KNOWLEDGE_NAME=<data-bucket-name>

# ── Gateway / Lambda naming (must match the pre-created role expectations) ───
GATEWAY_NAME=afwc-tactical-tools
LAMBDA_PREFIX=afwc-gateway-tool

# ── Identity Center (reference) ──────────────────────────────────────────────
IDENTITY_STORE_ID=<identity-store-id>
PARTICIPANT_USERNAME=<participant-username>

# ── Bedrock content-safety guardrail (optional) ──────────────────────────────
# All three are BLANK by default — blank means "run WITHOUT a guardrail", and
# the agents deploy and run exactly as before (no guardrail-create permissions
# needed). The runtime reads BEDROCK_GUARDRAIL_ID / BEDROCK_GUARDRAIL_VERSION
# from its environment and only attaches the guardrail to the model when the id
# is set (see constants.bedrock_model_kwargs()).
#
# To ENABLE: set CREATE_BEDROCK_GUARDRAIL=true and run the OWN-code helper
#   `uv run python src/agents/players/setup_guardrail.py`
# (it is NOT part of the off-limits cdk/ project). It creates the guardrail via
# boto3 and prints the id + version. Put those into BEDROCK_GUARDRAIL_ID /
# BEDROCK_GUARDRAIL_VERSION so they reach the agent runtimes' environment.
# NOTE: runtime env injection does NOT go through the vended cdk/ layer; provide
# the id/version to the runtimes through the deploy env mechanism.
CREATE_BEDROCK_GUARDRAIL=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# -- Model split: execution vs planning -------------------------------------
# EXECUTION (every player's per-tick command) always uses Nova Micro
# (constants.MODEL_ID) — fast + cheap, which matters under the ~2s cadence / 5s
# decision window. PLANNING (the per-tick strategy+formation decision) may use a
# STRONGER model because a wrong pick costs the whole tick. Set PLANNER_MODEL_ID
# to a stronger Bedrock id ENABLED in your account/region to upgrade planning;
# leave it BLANK to default to MODEL_ID so the deploy never breaks when no
# stronger model is confirmed. Candidate ids (enable in Bedrock first):
#   us.amazon.nova-pro-v1:0        (stronger Nova)
#   us.amazon.nova-lite-v1:0       (mid Nova)
#   us.anthropic.claude-3-5-haiku-20241022-v1:0  (Claude Haiku)
PLANNER_MODEL_ID=
# -- Dynamic roles flag ------------------------------------------------------
# player 0 is ALWAYS GK and player 1 ALWAYS DEF (hard-pinned). FLEX_ROLES lets
# players 2/3/4 reason about and adapt their own role (MID/FWD/support) given
# the strategy, instead of taking the formation's fixed distribution. Blank/0 =
# OFF (fixed distribution, default); 1/true/yes/on = ON.
FLEX_ROLES=
